# Root-level env vars consumed by docker-compose.yml.
# Per-service defaults live in backend/.env.example, frontend/.env.example,
# and ai-service/.env.example — copy this file to .env for the compose stack.

# Postgres
POSTGRES_DB=greencycle
POSTGRES_USER=greencycle
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=change-this-to-a-long-random-secret-value
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# AI service
AI_SERVICE_PORT=8000
AI_SERVICE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
